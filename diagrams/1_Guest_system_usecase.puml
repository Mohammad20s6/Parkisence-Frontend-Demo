@startuml Admin_UseCase
title **Parkisense — Admin Use Case Diagram**\nIntelligent Parkinson Detection Platform

' ============================================================
' Style Configuration
' ============================================================
skinparam actorStyle awesome
skinparam handwritten false
skinparam shadowing true
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam usecase {
  BackgroundColor #FFEBEE
  BorderColor #C62828
  FontColor #B71C1C
  FontSize 11
  StereotypeFontSize 9
  BackgroundColor<<auth>> #F3E5F5
  BorderColor<<auth>> #7B1FA2
  FontColor<<auth>> #4A148C
  BackgroundColor<<dash>> #E8EAF6
  BorderColor<<dash>> #283593
  FontColor<<dash>> #1A237E
  BackgroundColor<<patient>> #E3F2FD
  BorderColor<<patient>> #1565C0
  FontColor<<patient>> #0D47A1
  BackgroundColor<<test>> #FFF3E0
  BorderColor<<test>> #E65100
  FontColor<<test>> #BF360C
  BackgroundColor<<article>> #E8F5E9
  BorderColor<<article>> #2E7D32
  FontColor<<article>> #1B5E20
  BackgroundColor<<faq>> #E0F7FA
  BorderColor<<faq>> #00838F
  FontColor<<faq>> #006064
  BackgroundColor<<feedback>> #FCE4EC
  BorderColor<<feedback>> #AD1457
  FontColor<<feedback>> #880E4F
  BackgroundColor<<ai>> #FFF9C4
  BorderColor<<ai>> #F9A825
  FontColor<<ai>> #F57F17
}

skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #90A4AE
  FontColor #37474F
  FontSize 13
  FontStyle bold
  Style rectangle
}

skinparam actor {
  FontSize 14
  FontStyle bold
}

skinparam arrow {
  Color #546E7A
  FontSize 10
}

left to right direction

' ============================================================
' Actor
' ============================================================
actor "Guest" as G #FFCDD2

' ============================================================
' System Boundary
' ============================================================
rectangle "Parkisense — Guest Panel" {







    
    usecase "View Articles" as UC_Articles 
    usecase "View Faqs" as UC_Faqs
    usecase "View Home" as UC_Home
    usecase "SignUp" as UC_SignUp 
    usecase "Login" as UC_Login 
    usecase "Preview Article\n(Modal)" as UC_PreviewArticle
    usecase "Read Full Article\n(External Link)" as UC_ReadArticle    

  

 
    UC_PreviewArticle ..> UC_Articles : <<extend>>
    UC_ReadArticle ..> UC_PreviewArticle : <<extend>>

  

' ============================================================
' GuestAssociations
' ============================================================
G--> UC_Articles
G--> UC_Faqs
G--> UC_Home
G--> UC_SignUp
G --> UC_Login



  
' ============================================================
' <<include>> Relationships
' ============================================================


' ============================================================
' <<extend>> Relationships
' ============================================================


' ============================================================
' Legend
' ============================================================
legend bottom right
  |= Color |= Package |
  |<#F3E5F5> | Authentication |
  |<#E8EAF6> | Admin Dashboard |
  |<#E3F2FD> | Patient Management |
  |<#FFF3E0> | Test Management |
  |<#E8F5E9> | Article Management |
  |<#E0F7FA> | FAQ Management |
  |<#FCE4EC> | Feedback Management |
  |<#FFF9C4> | AI Monitoring |
  --
  **··>** <<include>> = Mandatory sub-flow
  **··>** <<extend>> = Optional sub-flow
endlegend

@enduml
