  "articles": [
    {
      "id": "1",
      "title": "Understanding Parkinson's Disease",
      "summary": "Parkinson's disease is a progressive neurological disorder that affects movement and coordination. It occurs due to the gradual loss of dopamine-producing neurons in the brain. Early symptoms may include tremors, stiffness, and slowed movements, which can worsen over time. While there is currently no cure, early detection and proper management can significantly improve quality of life. Treatments often involve medications, lifestyle changes, and sometimes surgical interventions. Understanding the disease is crucial for both patients and caregivers to manage symptoms effectively and maintain independence.",
      "category": "Education",
      "readTime": "8 min",
      "date": "2026-01-10",
      "source": "Mayo Clinic",
      "link": "https://www.mayoclinic.org/diseases-conditions/parkinsons-disease",
      "featured": true
    },
    {
      "id": "2",
      "title": "Early Warning Signs You Shouldn't Ignore",
      "summary": "Parkinson's disease often begins with subtle symptoms that are easy to overlook. These may include slight tremors, changes in handwriting, reduced facial expressions, or difficulty with balance. Recognizing these early warning signs is critical for timely diagnosis and treatment. Many patients delay seeking medical advice because symptoms appear minor at first. However, early intervention can slow disease progression and improve daily functioning. Raising awareness about these signs helps individuals take proactive steps toward better neurological health.",
      "category": "Symptoms",
      "readTime": "6 min",
      "date": "2026-01-08",
      "source": "WHO",
      "link": "https://www.who.int/news-room/fact-sheets/detail/parkinson-disease",
      "featured": false
    },
    {
      "id": "3",
      "title": "Managing Parkinson's in Daily Life",
      "summary": "Living with Parkinson's disease requires adapting daily routines to manage symptoms effectively. Regular exercise, a balanced diet, and consistent medication schedules play a key role in maintaining stability. Patients often benefit from physical therapy and speech therapy to improve mobility and communication. Emotional support is equally important, as the condition can impact mental health. With the right strategies and support systems, individuals can continue to lead fulfilling lives despite the challenges.",
      "category": "Lifestyle",
      "readTime": "7 min",
      "date": "2026-01-07",
      "source": "Healthline",
      "link": "https://www.healthline.com/health/parkinsons",
      "featured": false
    },
    {
      "id": "4",
      "title": "Advances in Parkinson's Research",
      "summary": "Recent advancements in Parkinson's research are offering new hope for patients worldwide. Scientists are exploring innovative treatments, including gene therapy and stem cell approaches, aimed at slowing or even reversing disease progression. Artificial intelligence is also being used to improve early diagnosis through voice and handwriting analysis. These breakthroughs highlight the importance of continued research and investment in neurological sciences. The future holds promising possibilities for more effective and personalized treatments.",
      "category": "Research",
      "readTime": "9 min",
      "date": "2026-01-05",
      "source": "Nature",
      "link": "https://www.nature.com",
      "featured": false
    }
  ],
